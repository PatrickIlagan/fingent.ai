# Optional public URL for deployment or links generated by the app.
APP_URL=http://localhost:3000

# Google sign-in for the browser version (and Firebase on phones). These are Firebase web-app settings,
# not a database credential. Enable Google sign-in and Drive API in the same project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Windows app Google sync: a Google Cloud OAuth client of type "Desktop app".
# Alternatively save its downloaded JSON as desktop/google-oauth.json (ignored by Git).
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
